# BlobTELEvision

# Python
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Downloaded weights (installed on first launch via the in-app Download button)
models/*
!models/README.txt

# Generated outputs and scratch space
outputs/*
!outputs/.gitkeep
work/

# Safety net: never commit weights
*.ckpt
*.safetensors
*.pth
*.bin

# Local logs
*.log
logs/

# Per-install local settings (e.g. the fast-reboot toggle)
/settings.json

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/
.cursor/
.claude/

# Tauri shell (tauri/): npm/cargo build artifacts, not source
tauri/node_modules/
tauri/dist/
tauri/src-tauri/target/
tauri/src-tauri/gen/

# Never commit credentials or signing material
.env
.env.*
*.pem
*.key
*.pfx
*.p12
