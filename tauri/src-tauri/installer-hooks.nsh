; Custom pages aren't available through tauri.conf.json's NSIS config in
; this Tauri version (no license/extra-page field on NsisConfig — checked
; against the actual struct, not just the docs) — a full custom `template`
; would mean forking and maintaining Tauri's entire default installer.nsi
; just for this one message. NSIS_HOOK_PREINSTALL (an officially documented
; installerHooks macro) fires right before file copying starts, which is
; the closest supported hook point to "before installing" — see
; https://v2.tauri.app/distribute/windows-installer/#installer-hooks

!macro NSIS_HOOK_PREINSTALL
  MessageBox MB_OK|MB_ICONINFORMATION "BlobTELEvision - before you install$\n$\n\
HARDWARE: tested on an NVIDIA RTX 3060 (12 GB VRAM) with 32 GB of RAM. An NVIDIA GPU with up-to-date drivers is effectively required - there's no practical CPU-only path. Speed and output size will vary a lot depending on your own hardware.$\n$\n\
DISK SPACE: first launch downloads a Python environment (several GB, mostly PyTorch). The model weights are a separate, optional download from inside the app: about 3.7 GB for text-to-video and about 5 GB more for image-to-video.$\n$\n\
OUTPUTS: every generated video stays in the app's outputs folder until you delete it yourself - nothing is cleaned up automatically.$\n$\n\
Click OK to continue installing." /SD IDOK
!macroend

; ---------------------------------------------------------------------------------------------
; Uninstall. The uninstaller generated by Tauri only deletes the files the installer copied
; (exe + app/). Everything the app created next to them afterwards would stay on the disk:
; the Python environment (venv/), the downloaded models, logs, scratch files, and the .pyc files
; Python writes into app/python. A running engine ("Fast reboot") also locks files in venv/.
; ---------------------------------------------------------------------------------------------

!macro NSIS_HOOK_PREUNINSTALL
  ; Ask a leftover engine to exit (also done on updates: its files are about to be replaced).
  nsExec::Exec 'powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command "try { Invoke-RestMethod -Method Post -Uri http://127.0.0.1:8421/shutdown -TimeoutSec 3 | Out-Null } catch {}"'
  Pop $0
  Sleep 1500
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  ; An update runs the old uninstaller with /UPDATE: never touch the user's data then.
  ${If} $UpdateMode <> 1
    ; Python caches created at runtime (not in the installer's own file list).
    RMDir /r "$INSTDIR\app\python\__pycache__"
    RMDir "$INSTDIR\app\python"
    RMDir "$INSTDIR\app\scripts"
    RMDir "$INSTDIR\app"

    ; Python environment + models (several GB). /DELETEDATA on the command line skips the question;
    ; a silent uninstall without it keeps the data.
    ${GetOptions} $CMDLINE "/DELETEDATA" $R0
    ${IfNot} ${Errors}
      Goto bt_wipe_data
    ${EndIf}
    MessageBox MB_YESNO|MB_ICONQUESTION "Also delete the Python environment and the downloaded model weights (several GB)?$\n$\nThey are in:$\n$INSTDIR$\n$\nYour generated videos are NOT deleted by this." /SD IDNO IDYES bt_wipe_data IDNO bt_keep_data

    bt_wipe_data:
    ; Only our own folders, by name: the install folder may be shared with something else.
    ${If} ${FileExists} "$INSTDIR\venv\.bootstrap_complete"
    ${OrIf} ${FileExists} "$INSTDIR\venv\Scripts\python.exe"
      ; site-packages has paths longer than the 260 chars NSIS' RMDir can handle in a deep install
      ; folder: cmd's rmdir with the \\?\ prefix does, RMDir /r then cleans up whatever is left.
      nsExec::Exec 'cmd.exe /c rmdir /s /q "\\?\$INSTDIR\venv"'
      Pop $0
      RMDir /r "$INSTDIR\venv"
    ${EndIf}
    RMDir /r "$INSTDIR\models\modelscope-t2v"
    RMDir /r "$INSTDIR\models\i2vgen-xl"
    RMDir /r "$INSTDIR\models\upscale"
    RMDir /r "$INSTDIR\models\rife"
    Delete "$INSTDIR\models\README.txt"
    RMDir "$INSTDIR\models"
    RMDir /r "$INSTDIR\work"
    Delete "$INSTDIR\logs\*.log"
    RMDir "$INSTDIR\logs"
    Delete "$INSTDIR\settings.json"
    RMDir /r "$INSTDIR\.uv-cache"

    ; Generated videos: separate question that always defaults to keeping them.
    MessageBox MB_YESNO|MB_ICONQUESTION "Also delete the videos you generated (the outputs folder)?$\n$\n$INSTDIR\outputs" /SD IDNO IDYES bt_wipe_outputs IDNO bt_keep_outputs
    bt_wipe_outputs:
    Delete "$INSTDIR\outputs\*.mp4"
    Delete "$INSTDIR\outputs\*.json"
    Delete "$INSTDIR\outputs\_live_preview.png"
    RMDir /r "$INSTDIR\outputs\uploads"
    Delete "$INSTDIR\outputs\.gitkeep"
    bt_keep_outputs:
    RMDir "$INSTDIR\outputs"

    bt_keep_data:
    ; Removes the install folder itself when nothing of the user's is left in it.
    RMDir "$INSTDIR"
  ${EndIf}
!macroend
